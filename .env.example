# Copy this file to ".env" and paste your free Mapbox access token.
# Get one at https://account.mapbox.com/access-tokens/ (the default public token is fine).
# After editing .env you MUST restart the bundler with a cleared cache:  npx expo start -c
EXPO_PUBLIC_MAPBOX_TOKEN=pk.YOUR_MAPBOX_TOKEN_HERE

# Optional: LocalRun community backend (see server/). When set, saved runs are
# shared anonymously and everyone's photos/ratings improve route suggestions.
# Run locally with:  npm run server   (then use your machine's LAN IP, not localhost)
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8787
